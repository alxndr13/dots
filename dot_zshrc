# The `watch` alias breaks zsh's parse of Otty's watch() wrapper (aliases
# expand at parse time) — drop it before the Otty block, restore at the first
# prompt via a one-shot precmd. Otty moves its >>>/<<< block to the end of the
# file on rewrite, so a plain "re-alias after the block" line keeps ending up
# in front of it; the precmd fires after every place Otty sources the payload
# (inline block AND its deferred ZDOTDIR loader), independent of file order.
if [ -n "$OTTY_SHELL_INTEGRATION" ]; then
  unalias watch 2>/dev/null
  __restore_watch_alias() {
    alias watch='watch '
    precmd_functions=(${precmd_functions:#__restore_watch_alias})
    unfunction __restore_watch_alias
  }
  typeset -ag precmd_functions
  precmd_functions+=(__restore_watch_alias)
fi
