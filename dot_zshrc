# Jarvis gaming mode: unload NanoClaw and stop OrbStack, then optionally
# schedule a one-shot restart for later.
export JARVIS_LAUNCH_LABEL="com.nanoclaw-v2-6ee00f8d"
export JARVIS_LAUNCH_PLIST="$HOME/Library/LaunchAgents/com.nanoclaw-v2-6ee00f8d.plist"

function jarvis-stop() {
  local domain="gui/$(id -u)"
  launchctl bootout "$domain/$JARVIS_LAUNCH_LABEL" 2>/dev/null || launchctl remove "$JARVIS_LAUNCH_LABEL" 2>/dev/null || true
  orbctl stop
}

function jarvis-start() {
  local domain="gui/$(id -u)"
  orbctl start
  launchctl bootstrap "$domain" "$JARVIS_LAUNCH_PLIST" 2>/dev/null || true
  launchctl kickstart -k "$domain/$JARVIS_LAUNCH_LABEL"
}

function jarvis-start-at() {
  local when="${1:-02:00}"
  local lower="${when:l}"
  local hour minute suffix

  if [[ "$lower" =~ '^([0-9]{1,2})(:([0-9]{2}))?([ap]m)$' ]]; then
    hour="${match[1]}"
    minute="${match[3]:-00}"
    suffix="${match[4]}"
    if [[ "$suffix" == "pm" && "$hour" -lt 12 ]]; then hour=$((hour + 12)); fi
    if [[ "$suffix" == "am" && "$hour" -eq 12 ]]; then hour=0; fi
  elif [[ "$lower" =~ '^([0-9]{1,2})(:([0-9]{2}))?$' ]]; then
    hour="${match[1]}"
    minute="${match[3]:-00}"
  else
    echo "usage: jarvis-start-at HH[:MM] | 2am | 2:30am" >&2
    return 2
  fi

  if (( hour < 0 || hour > 23 || minute < 0 || minute > 59 )); then
    echo "invalid time: $when" >&2
    return 2
  fi

  local uid="$(id -u)"
  local label="com.jarvis.scheduled-start"
  local plist="$HOME/Library/LaunchAgents/$label.plist"
  local cmd="/opt/homebrew/bin/orbctl start; /bin/launchctl bootstrap gui/$uid \"$JARVIS_LAUNCH_PLIST\" 2>/dev/null || true; /bin/launchctl kickstart -k gui/$uid/$JARVIS_LAUNCH_LABEL; /bin/launchctl bootout gui/$uid/$label 2>/dev/null; /bin/rm -f \"$plist\""

  launchctl bootout "gui/$uid/$label" 2>/dev/null || true
  command cat > "$plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$label</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string><![CDATA[$cmd]]></string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>$hour</integer>
    <key>Minute</key>
    <integer>$minute</integer>
  </dict>
</dict>
</plist>
EOF
  launchctl bootstrap "gui/$uid" "$plist"
  printf "Jarvis restart scheduled for %02d:%02d.\\n" "$hour" "$minute"
}

